{
  "expo": {
    "name": "Sagana",
    "slug": "sagana-mobile",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/sagana_logo.png",
    "scheme": "sagana",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.sagana.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FAF9EE",
        "foregroundImage": "./assets/sagana_logo.png"
      },
      "package": "com.sagana.mobile",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/sagana_logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-image",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/sagana_logo.png",
          "backgroundColor": "#FAF9EE",
          "resizeMode": "contain"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "@config-plugins/react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [
            "central"
          ],
          "bluetoothAlwaysPermission": "Allow Sagana to connect to hardware via Bluetooth."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Sagana to use your location to discover nearby hardware."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Sagana to scan QR codes for hardware pairing."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "a26cfdef-fea7-48f9-8bfd-d56651542c70"
      }
    }
  }
}
